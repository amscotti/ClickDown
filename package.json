{
  "name": "clickdown",
  "packageManager": "bun@1.4.4",
  "module": "src/index.tsx",
  "license": "MIT",
  "dependencies": {
    "@alpinejs/csp": "3.17.5",
    "@kitajs/html": "^4.2.13",
    "@picocss/pico": "2.1.1",
    "bcrypt": "^6.0.0",
    "htmx-ext-ws": "2.0.4",
    "htmx.org": "2.0.11",
    "nanoid": "^5.1.6",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@kitajs/ts-html-plugin": "4.1.4",
    "@playwright/test": "^1.60.0",
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  },
  "private": true,
  "scripts": {
    "dev": "bun --hot src/index.tsx",
    "start": "bun src/index.tsx",
    "build": "bun build src/index.tsx --outdir=dist --target=bun",
    "test": "bun test tests/unit tests/integration",
    "test:coverage": "bun test tests/unit tests/integration --coverage",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "xss:scan": "tsc --noEmit",
    "ci": "bun run typecheck && bun run xss:scan && bun run lint && bun run test",
    "db:migrate": "bun scripts/migrate.ts",
    "ci:full": "bun run ci && bun run test:e2e",
    "smoke:docker": "docker build -t clickdown-smoke . && docker run --rm -d --name clickdown-smoke -p 3002:3000 clickdown-smoke; for i in $(seq 1 30); do curl -sf http://localhost:3002/ready && break || sleep 1; done; curl -sf http://localhost:3002/health; docker rm -f clickdown-smoke",
    "test:e2e:smoke": "playwright test tests/e2e/auth.spec.ts tests/e2e/security-features.spec.ts tests/e2e/new-product-features.spec.ts --retries=1"
  },
  "type": "module"
}
