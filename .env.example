# Direct local hosting works without configuration.
PORT=3000
DB_PATH=data/clickdown.db
UPLOAD_DIR=data/uploads
LOG_LEVEL=info

# Enable for deployed/production behavior (strict CSRF Origin checks).
# Leave unset for local development.
# NODE_ENV=production

# Set APP_URL when ClickDown is behind a reverse proxy or has a public URL.
# APP_URL=https://tasks.example.com
# TRUST_PROXY=true
# COOKIE_SECURE=true
